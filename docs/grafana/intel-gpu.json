{
  "title": "Intel GPU",
  "uid": "intel-gpu",
  "schemaVersion": 39,
  "version": 2,
  "tags": ["intel", "gpu", "prometheus"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"}
      },
      {
        "name": "card",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(intel_gpu_info, card)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {"id": 100, "type": "row", "title": "Overview", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 1, "type": "table", "title": "GPU inventory",
      "gridPos": {"x": 0, "y": 1, "w": 24, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "intel_gpu_info{card=~\"$card\"}", "format": "table", "instant": true}],
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "job": true, "instance": true}}}]
    },
    {
      "id": 2, "type": "stat", "title": "Scrape success per source",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FAIL", "color": "red"}, "1": {"text": "OK", "color": "green"}}}]}},
      "targets": [{"refId": "A", "expr": "intel_gpu_scrape_success", "legendFormat": "{{source}}", "instant": true}]
    },
    {
      "id": 3, "type": "timeseries", "title": "Scrape duration per source",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{"refId": "A", "expr": "intel_gpu_scrape_duration_seconds", "legendFormat": "{{source}}"}]
    },
    {
      "id": 4, "type": "stat", "title": "fdinfo processes dropped (top-N cap)",
      "gridPos": {"x": 0, "y": 10, "w": 24, "h": 3},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "intel_gpu_client_dropped_processes", "instant": true}]
    },

    {"id": 110, "type": "row", "title": "Frequency", "gridPos": {"x": 0, "y": 13, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 10, "type": "timeseries", "title": "GT frequency — actual vs requested (i915)",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "MHz"}},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_i915_frequency_actual_mhz{card=~\"$card\"}", "legendFormat": "{{card}}/gt{{gt}} actual"},
        {"refId": "B", "expr": "intel_gpu_i915_frequency_requested_mhz{card=~\"$card\"}", "legendFormat": "{{card}}/gt{{gt}} requested"}
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "GT frequency — actual vs requested (xe)",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "MHz"}},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_xe_frequency_actual_mhz{card=~\"$card\"}", "legendFormat": "{{card}}/t{{tile}}g{{gt}} actual"},
        {"refId": "B", "expr": "intel_gpu_xe_frequency_requested_mhz{card=~\"$card\"}", "legendFormat": "{{card}}/t{{tile}}g{{gt}} requested"}
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Hardware frequency limits (RP0 / RPn / min / max)",
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "MHz"}},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_i915_frequency_rp0_mhz{card=~\"$card\"}", "legendFormat": "i915 {{card}}/gt{{gt}} RP0"},
        {"refId": "B", "expr": "intel_gpu_i915_frequency_rpn_mhz{card=~\"$card\"}", "legendFormat": "i915 {{card}}/gt{{gt}} RPn"},
        {"refId": "C", "expr": "intel_gpu_i915_frequency_min_mhz{card=~\"$card\"}", "legendFormat": "i915 {{card}}/gt{{gt}} min"},
        {"refId": "D", "expr": "intel_gpu_i915_frequency_max_mhz{card=~\"$card\"}", "legendFormat": "i915 {{card}}/gt{{gt}} max"},
        {"refId": "E", "expr": "intel_gpu_xe_frequency_rp0_mhz{card=~\"$card\"}", "legendFormat": "xe {{card}}/t{{tile}}g{{gt}} RP0"},
        {"refId": "F", "expr": "intel_gpu_xe_frequency_rpa_mhz{card=~\"$card\"}", "legendFormat": "xe {{card}}/t{{tile}}g{{gt}} RPa"},
        {"refId": "G", "expr": "intel_gpu_xe_frequency_rpn_mhz{card=~\"$card\"}", "legendFormat": "xe {{card}}/t{{tile}}g{{gt}} RPn"}
      ]
    },

    {"id": 120, "type": "row", "title": "Power & energy", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 20, "type": "timeseries", "title": "Power limits (hwmon)",
      "gridPos": {"x": 0, "y": 31, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "watt"}},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_hwmon_power_max_watts{card=~\"$card\"}", "legendFormat": "{{card}} ch{{channel}} PL1"},
        {"refId": "B", "expr": "intel_gpu_hwmon_power_rated_max_watts{card=~\"$card\"}", "legendFormat": "{{card}} ch{{channel}} TDP"},
        {"refId": "C", "expr": "intel_gpu_hwmon_power_crit_watts{card=~\"$card\"}", "legendFormat": "{{card}} ch{{channel}} crit"}
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "Power draw (rate of energy)",
      "gridPos": {"x": 12, "y": 31, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "watt"}},
      "targets": [
        {"refId": "A", "expr": "rate(intel_gpu_hwmon_energy_joules_total{card=~\"$card\"}[1m])", "legendFormat": "hwmon {{card}} ch{{channel}}"},
        {"refId": "B", "expr": "rate(intel_gpu_zes_energy_microjoules_total[1m]) / 1e6", "legendFormat": "zes {{pci}}/{{subdevice}} dom{{domain}}"}
      ]
    },
    {
      "id": 22, "type": "timeseries", "title": "Voltage (hwmon)",
      "gridPos": {"x": 0, "y": 39, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "volt"}},
      "targets": [{"refId": "A", "expr": "intel_gpu_hwmon_voltage_volts{card=~\"$card\"}", "legendFormat": "{{card}} ch{{channel}}"}]
    },
    {
      "id": 23, "type": "timeseries", "title": "Current (hwmon)",
      "gridPos": {"x": 12, "y": 39, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "amp"}},
      "targets": [{"refId": "A", "expr": "intel_gpu_hwmon_current_amperes{card=~\"$card\"}", "legendFormat": "{{card}} ch{{channel}}"}]
    },

    {"id": 130, "type": "row", "title": "Thermal", "gridPos": {"x": 0, "y": 45, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 30, "type": "timeseries", "title": "Temperature (hwmon)",
      "gridPos": {"x": 0, "y": 46, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "celsius"}},
      "targets": [{"refId": "A", "expr": "intel_gpu_hwmon_temperature_celsius{card=~\"$card\"}", "legendFormat": "{{card}} ch{{channel}}"}]
    },
    {
      "id": 31, "type": "timeseries", "title": "Fan tachometer",
      "gridPos": {"x": 12, "y": 46, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "rotrpm"}},
      "targets": [{"refId": "A", "expr": "intel_gpu_hwmon_fan_rpm{card=~\"$card\"}", "legendFormat": "{{card}} ch{{channel}}"}]
    },

    {"id": 140, "type": "row", "title": "Engine utilisation", "gridPos": {"x": 0, "y": 54, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 40, "type": "timeseries", "title": "Engine busy (PMU)",
      "gridPos": {"x": 0, "y": 55, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [{"refId": "A", "expr": "rate(intel_gpu_pmu_counter{family=\"engine\",kind=\"busy\"}[1m]) / 1e9", "legendFormat": "{{pmu}} / {{engine}}"}]
    },
    {
      "id": 41, "type": "timeseries", "title": "Engine semaphore / wait (PMU)",
      "gridPos": {"x": 12, "y": 55, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [
        {"refId": "A", "expr": "rate(intel_gpu_pmu_counter{family=\"engine\",kind=\"sema\"}[1m]) / 1e9", "legendFormat": "sema {{pmu}}/{{engine}}"},
        {"refId": "B", "expr": "rate(intel_gpu_pmu_counter{family=\"engine\",kind=\"wait\"}[1m]) / 1e9", "legendFormat": "wait {{pmu}}/{{engine}}"}
      ]
    },
    {
      "id": 42, "type": "timeseries", "title": "RC6 / C6 residency",
      "description": "Idle ratio. PMU series is preferred; the i915 sysfs counter is a fallback when PMU isn't reachable (no CAP_PERFMON / paranoid > 1).",
      "gridPos": {"x": 0, "y": 63, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [
        {"refId": "A", "expr": "rate(intel_gpu_pmu_counter{family=\"rc6\"}[1m]) / 1e9", "legendFormat": "pmu {{pmu}}"},
        {"refId": "B", "expr": "rate(intel_gpu_i915_rc6_residency_ms{card=~\"$card\"}[1m]) / 1000", "legendFormat": "sysfs {{card}}"}
      ]
    },
    {
      "id": 43, "type": "timeseries", "title": "Interrupts / sec (PMU)",
      "gridPos": {"x": 8, "y": 63, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [{"refId": "A", "expr": "rate(intel_gpu_pmu_counter{family=\"interrupts\"}[1m])", "legendFormat": "{{pmu}}"}]
    },
    {
      "id": 44, "type": "timeseries", "title": "Software GT awake time",
      "gridPos": {"x": 16, "y": 63, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [{"refId": "A", "expr": "rate(intel_gpu_pmu_counter{family=\"awake\"}[1m]) / 1e9", "legendFormat": "{{pmu}}"}]
    },
    {
      "id": 45, "type": "table", "title": "Top processes by GPU engine time (5m rate)",
      "gridPos": {"x": 0, "y": 71, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "topk(20, sum by (pid, comm, engine, pci) (rate(intel_gpu_client_engine_time_seconds_total[5m])))", "format": "table", "instant": true}]
    },

    {"id": 150, "type": "row", "title": "Memory", "gridPos": {"x": 0, "y": 79, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 50, "type": "stat", "title": "VRAM / local memory total",
      "gridPos": {"x": 0, "y": 80, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_memory_lmem_total_bytes{card=~\"$card\"}", "legendFormat": "{{card}} lmem"},
        {"refId": "B", "expr": "intel_gpu_memory_vram_total_bytes{card=~\"$card\"}", "legendFormat": "{{card}} tile{{tile}}"}
      ]
    },
    {
      "id": 51, "type": "table", "title": "Per-client memory (top 20 by resident)",
      "gridPos": {"x": 12, "y": 80, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "topk(20, sum by (pid, comm, region, pci) (intel_gpu_client_memory_resident_bytes))", "format": "table", "instant": true}]
    },

    {"id": 160, "type": "row", "title": "PCIe", "gridPos": {"x": 0, "y": 86, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 60, "type": "stat", "title": "PCIe generation (current / max)",
      "gridPos": {"x": 0, "y": 87, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_pcie_current_generation{card=~\"$card\"}", "legendFormat": "{{card}} cur"},
        {"refId": "B", "expr": "intel_gpu_pcie_max_generation{card=~\"$card\"}", "legendFormat": "{{card}} max"}
      ]
    },
    {
      "id": 61, "type": "stat", "title": "PCIe link width (current / max)",
      "gridPos": {"x": 12, "y": 87, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_pcie_current_link_width{card=~\"$card\"}", "legendFormat": "{{card}} cur"},
        {"refId": "B", "expr": "intel_gpu_pcie_max_link_width{card=~\"$card\"}", "legendFormat": "{{card}} max"}
      ]
    },

    {"id": 170, "type": "row", "title": "Throttle reasons (xe)", "gridPos": {"x": 0, "y": 91, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 70, "type": "timeseries", "title": "Active throttle reasons",
      "gridPos": {"x": 0, "y": 92, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "intel_gpu_xe_throttle_reason{card=~\"$card\"} > 0", "legendFormat": "{{card}} t{{tile}}g{{gt}} {{reason}}"}]
    },

    {"id": 175, "type": "row", "title": "Utilization & correlations", "gridPos": {"x": 0, "y": 98, "w": 24, "h": 1}, "collapsed": false},
    {
      "id": 76, "type": "timeseries", "title": "Frequency headroom (actual / RP0)",
      "description": "How close the GPU is running to its max physical frequency. 1.0 = pinned at RP0.",
      "gridPos": {"x": 0, "y": 99, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_i915_frequency_actual_mhz{card=~\"$card\"} / on(card, pci, gt) intel_gpu_i915_frequency_rp0_mhz", "legendFormat": "i915 {{card}}/gt{{gt}}"},
        {"refId": "B", "expr": "intel_gpu_xe_frequency_actual_mhz{card=~\"$card\"} / on(card, pci, tile, gt) intel_gpu_xe_frequency_rp0_mhz", "legendFormat": "xe {{card}}/t{{tile}}g{{gt}}"}
      ]
    },
    {
      "id": 77, "type": "timeseries", "title": "Power utilization (draw / PL1)",
      "description": "Fraction of the sustained power limit being used right now. >1 = burst above PL1.",
      "gridPos": {"x": 8, "y": 99, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}},
      "targets": [{"refId": "A", "expr": "rate(intel_gpu_hwmon_energy_joules_total{card=~\"$card\"}[1m]) / on(card, pci, channel) intel_gpu_hwmon_power_max_watts", "legendFormat": "{{card}} ch{{channel}}"}]
    },
    {
      "id": 78, "type": "timeseries", "title": "Engine busy vs power draw",
      "description": "Workload efficiency: spikes in busy without matching power growth, or vice versa, hint at non-compute bottlenecks.",
      "gridPos": {"x": 16, "y": 99, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum by (pmu) (rate(intel_gpu_pmu_counter{family=\"engine\",kind=\"busy\"}[1m])) / 1e9", "legendFormat": "busy {{pmu}}"},
        {"refId": "B", "expr": "sum by (card) (rate(intel_gpu_hwmon_energy_joules_total{card=~\"$card\"}[1m]))", "legendFormat": "watts {{card}}"}
      ]
    },
    {
      "id": 79, "type": "timeseries", "title": "Temperature vs xe throttle reasons",
      "description": "Overlay to identify thermal- vs power-limited throttling. Temperature on left axis, active throttle flags as step series.",
      "gridPos": {"x": 0, "y": 106, "w": 24, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "intel_gpu_hwmon_temperature_celsius{card=~\"$card\"}", "legendFormat": "°C {{card}} ch{{channel}}"},
        {"refId": "B", "expr": "intel_gpu_xe_throttle_reason{card=~\"$card\"} > 0", "legendFormat": "throttle {{card}} t{{tile}}g{{gt}} {{reason}}"}
      ]
    },

    {"id": 180, "type": "row", "title": "Engine config (i915)", "gridPos": {"x": 0, "y": 113, "w": 24, "h": 1}, "collapsed": true,
      "panels": [
        {
          "id": 80, "type": "timeseries", "title": "Heartbeat / preempt / stop / timeslice intervals",
          "gridPos": {"x": 0, "y": 99, "w": 24, "h": 6},
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "ms"}},
          "targets": [
            {"refId": "A", "expr": "intel_gpu_engine_heartbeat_interval_ms{card=~\"$card\"}", "legendFormat": "heartbeat {{card}}/{{engine}}"},
            {"refId": "B", "expr": "intel_gpu_engine_preempt_timeout_ms{card=~\"$card\"}", "legendFormat": "preempt {{card}}/{{engine}}"},
            {"refId": "C", "expr": "intel_gpu_engine_stop_timeout_ms{card=~\"$card\"}", "legendFormat": "stop {{card}}/{{engine}}"},
            {"refId": "D", "expr": "intel_gpu_engine_timeslice_duration_ms{card=~\"$card\"}", "legendFormat": "timeslice {{card}}/{{engine}}"}
          ]
        }
      ]
    },

    {"id": 190, "type": "row", "title": "Level Zero / sysman (Data Center GPUs)", "gridPos": {"x": 0, "y": 105, "w": 24, "h": 1}, "collapsed": true,
      "panels": [
        {
          "id": 90, "type": "timeseries", "title": "Temperature per sensor",
          "gridPos": {"x": 0, "y": 106, "w": 12, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "celsius"}},
          "targets": [{"refId": "A", "expr": "intel_gpu_zes_temperature_celsius", "legendFormat": "{{pci}}/{{subdevice}} {{sensor}}"}]
        },
        {
          "id": 91, "type": "timeseries", "title": "Frequency (actual / request / TDP)",
          "gridPos": {"x": 12, "y": 106, "w": 12, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "MHz"}},
          "targets": [
            {"refId": "A", "expr": "intel_gpu_zes_frequency_actual_mhz", "legendFormat": "act {{pci}}/{{subdevice}}/{{domain}}"},
            {"refId": "B", "expr": "intel_gpu_zes_frequency_request_mhz", "legendFormat": "req {{pci}}/{{subdevice}}/{{domain}}"},
            {"refId": "C", "expr": "intel_gpu_zes_frequency_tdp_mhz", "legendFormat": "tdp {{pci}}/{{subdevice}}/{{domain}}"}
          ]
        },
        {
          "id": 92, "type": "timeseries", "title": "Frequency throttle time (rate)",
          "gridPos": {"x": 0, "y": 114, "w": 12, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "percentunit"}},
          "targets": [{"refId": "A", "expr": "rate(intel_gpu_zes_frequency_throttle_nanoseconds_total[1m]) / 1e9", "legendFormat": "{{pci}}/{{subdevice}}/{{domain}}"}]
        },
        {
          "id": 93, "type": "timeseries", "title": "Engine active per group",
          "gridPos": {"x": 12, "y": 114, "w": 12, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "percentunit"}},
          "targets": [{"refId": "A", "expr": "rate(intel_gpu_zes_engine_active_nanoseconds_total[1m]) / 1e9", "legendFormat": "{{pci}}/{{subdevice}} {{engine}}"}]
        },
        {
          "id": 94, "type": "timeseries", "title": "RAS errors (correctable vs uncorrectable, per category)",
          "gridPos": {"x": 0, "y": 122, "w": 24, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "targets": [{"refId": "A", "expr": "increase(intel_gpu_zes_ras_errors_total[5m]) > 0", "legendFormat": "{{type}} {{category}} {{pci}}/{{subdevice}}"}]
        },
        {
          "id": 95, "type": "timeseries", "title": "Memory size / free",
          "gridPos": {"x": 0, "y": 130, "w": 12, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "bytes"}},
          "targets": [
            {"refId": "A", "expr": "intel_gpu_zes_memory_size_bytes", "legendFormat": "size {{pci}}/{{subdevice}} {{module}}"},
            {"refId": "B", "expr": "intel_gpu_zes_memory_free_bytes", "legendFormat": "free {{pci}}/{{subdevice}} {{module}}"}
          ]
        },
        {
          "id": 96, "type": "timeseries", "title": "Memory bandwidth (read / write)",
          "gridPos": {"x": 12, "y": 130, "w": 12, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "fieldConfig": {"defaults": {"unit": "Bps"}},
          "targets": [
            {"refId": "A", "expr": "rate(intel_gpu_zes_memory_read_bytes_total[1m])", "legendFormat": "read {{pci}}/{{subdevice}} {{module}}"},
            {"refId": "B", "expr": "rate(intel_gpu_zes_memory_write_bytes_total[1m])", "legendFormat": "write {{pci}}/{{subdevice}} {{module}}"}
          ]
